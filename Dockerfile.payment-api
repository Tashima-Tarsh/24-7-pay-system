# ============================================================
# DYNAMO PAY — Dockerfile for Payment API (Node.js)
# Multi-stage build for production with monorepo workspace support
# ============================================================

FROM node:22-alpine

WORKDIR /app

# Install production dependencies
# Copy root package files first for layer caching
COPY package.json package-lock.json ./

# Copy workspace package.json files so npm install can resolve workspaces
COPY packages/common/package.json ./packages/common/
COPY packages/core/package.json ./packages/core/
COPY packages/db/package.json ./packages/db/
COPY packages/observer-sdk/package.json ./packages/observer-sdk/
COPY packages/merchant-sdk/package.json ./packages/merchant-sdk/
COPY apps/payment-api/package.json ./apps/payment-api/
COPY apps/checkout-portal/package.json ./apps/checkout-portal/
COPY apps/merchant-admin/package.json ./apps/merchant-admin/
COPY apps/super-admin/package.json ./apps/super-admin/
COPY apps/sms-observer/package.json ./apps/sms-observer/
COPY apps/gmail-observer/package.json ./apps/gmail-observer/
COPY apps/android-bridge/package.json ./apps/android-bridge/

# Install all workspace dependencies
RUN npm install --omit=dev --no-audit --no-fund

# Copy source code
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts

# Create non-root user
RUN addgroup -S dynamopay && adduser -S dynamopay -G dynamopay
RUN chown -R dynamopay:dynamopay /app
USER dynamopay

# Health check
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:6100/health || exit 1

EXPOSE 6100 9000

# Default command (overridden per service)
CMD ["node", "apps/payment-api/src/index.js"]
