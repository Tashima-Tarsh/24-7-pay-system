# 24/7 Pay — environment template
# Copy to `.env` and fill in real values. In production the server refuses to boot if any
# required secret is missing, too short, or a known placeholder (see scripts/validate-env.js).

# Environment (required)
NODE_ENV=production

# Storage (required in production: financial data on ephemeral SQLite is refused)
DATABASE_URL=postgresql://user:password@host:5432/youpi

# Core secrets (required; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_MASTER_KEY=
JWT_SECRET=
ORDER_SIGNING_SECRET=

# Service credentials (required in production — never auto-generated per instance)
# These must be identical on every replica: they gate admin routes, internal service calls
# and the blind indexes used to look up hashed tokens.
ADMIN_API_TOKEN=
INTERNAL_SERVICE_TOKEN=
OBSERVER_API_TOKEN=

# Initial admin (required)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# Public URL of this deployment (used to build checkout links)
BASE_PAYMENT_API_URL=https://your-service.example.com

# Optional
# ALLOWED_ORIGINS=https://merchant.example.com,https://admin.example.com
# TRUST_PROXY=true            # set only when a reverse proxy/CDN sits in front of the gateway
# YOUPI_ALLOW_PRIVATE_WEBHOOKS=false
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_WEBHOOK_SECRET=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
