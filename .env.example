# Sanbook Pay — Render Environment Variables
# Set these in Render Dashboard → Your Service → Environment tab

# Admin credentials (fallback defaults are kunal12@gmail.com / <GENERATED_SECURE_PASSWORD>)
# NEVER use default or weak passwords in production. The server will refuse to start if this default is detected.
INITIAL_ADMIN_EMAIL=kunal12@gmail.com
INITIAL_ADMIN_PASSWORD=<GENERATE_SECURE_32_CHAR_STRING>

# Gmail OAuth (required for Gmail payment notification capture)
GMAIL_OAUTH_CLIENT_ID=your_gmail_client_id
GMAIL_OAUTH_CLIENT_SECRET=your_gmail_client_secret
GMAIL_OAUTH_CALLBACK_PATH=/api/v1/gmail/callback

# Payment API URL (for device pairing QR links)
BASE_PAYMENT_API_URL=https://your-service.onrender.com

# Environment
NODE_ENV=production

# Optional: bypass verification for testing
# SKIP_MFA=1
# SKIP_EMAIL_VERIFY=1
# SKIP_MOBILE_VERIFY=1
